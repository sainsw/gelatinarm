<?xml version="1.0" encoding="utf-8" ?>

<base:BasePage
    x:Class="Gelatinarm.Search.RequestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Gelatinarm.Shared.Base"
    xmlns:server="using:Gelatinarm.Shared.Server"
    xmlns:ui="using:Gelatinarm.Shared.Ui"
    Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Image Source="{x:Bind ViewModel.BackdropImage, Mode=OneWay}" Stretch="UniformToFill" />
        <Grid Background="{StaticResource OverlayScrimBrush}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Padding="{StaticResource SafeAreaPadding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="200"
                    Height="300"
                    Margin="{StaticResource SafeAreaPadding}"
                    VerticalAlignment="Top"
                    Background="{StaticResource SystemChromeMediumBrush}"
                    CornerRadius="2">
                    <Image Source="{x:Bind ViewModel.PosterImage, Mode=OneWay}" Stretch="UniformToFill" />
                </Border>

                <StackPanel
                    Grid.Column="1"
                    Margin="{StaticResource HeaderMargin}"
                    VerticalAlignment="Top">
                    <TextBlock
                        Margin="0,0,0,8"
                        Style="{StaticResource PageTitleTextStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{StaticResource SystemControlHighlightAccentBrush}"
                        Style="{StaticResource StandardBodyTextStyle}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    <TextBlock
                        MaxWidth="900"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource StandardBodyTextStyle}"
                        Text="{x:Bind ViewModel.Overview, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <StackPanel
                        Margin="0,24,0,0"
                        Orientation="Horizontal"
                        Spacing="12">
                        <Button
                            x:Name="RequestButton"
                            Command="{x:Bind ViewModel.RequestCommand}"
                            Content="Request"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            Command="{x:Bind ViewModel.SelectAllSeasonsCommand}"
                            Content="Select all seasons"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsSeries, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,12,0,0"
                        Style="{StaticResource StandardBodyTextStyle}"
                        Text="{x:Bind ViewModel.Message, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.Message, Mode=OneWay, Converter={StaticResource NullableToVisibilityConverter}}" />

                    <!--  An ItemsControl, not a ListView: each check box takes focus itself, so A ticks it  -->
                    <ItemsControl
                        Margin="0,16,0,0"
                        IsTabStop="False"
                        ItemsSource="{x:Bind ViewModel.Seasons}"
                        Visibility="{x:Bind ViewModel.IsSeries, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="server:SeerrSeason">
                                <CheckBox
                                    Margin="0,4"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                    IsEnabled="{x:Bind IsRequestable}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource StandardBodyTextStyle}" Text="{x:Bind Name}" />
                                        <TextBlock Style="{StaticResource StandardCaptionTextStyle}" Text="{x:Bind Details}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <ui:LoadingOverlay IsLoading="{x:Bind ViewModel.IsLoading, Mode=OneWay}" LoadingText="Asking Seerr..." />
    </Grid>
</base:BasePage>
